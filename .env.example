RADARPRICE_DATABASE_URL=sqlite+aiosqlite:///./radarprice.db
RADARPRICE_SEED_ON_STARTUP=true
# Obligatoria para POST /api/v1/sync (cabecera X-API-Key). Vacía → el endpoint responde 503.
# Genera una: python -c "import secrets; print(secrets.token_urlsafe(32))"
RADARPRICE_SYNC_API_KEY=
RADARPRICE_SQL_ECHO=false
# Datos de demostración (tiendas simuladas + histórico sintético). Producción: false.
RADARPRICE_DEMO_DATA=true
# Sync automático cada N minutos (mínimo 5). Vacío = solo manual. Usar con 1 worker.
RADARPRICE_SYNC_INTERVAL_MINUTES=
